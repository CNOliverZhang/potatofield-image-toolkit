{
  "name": "potatofield-image-toolkit",
  "version": "2.0.0",
  "description": "洋芋田图像工具箱 - Electron + Vue 3 重写版",
  "author": "Potatofield",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .js,.ts,.vue",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "colorthief": "^2.4.0",
    "crypto-js": "^4.2.0",
    "cropperjs": "^1.6.1",
    "element-plus": "^2.7.0",
    "exifr": "^7.1.3",
    "html2canvas": "^1.4.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/vue-fontawesome": "^3.0.6"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  },
  "optionalDependencies": {
    "sharp": "^0.33.4"
  },
  "build": {
    "appId": "cn.potatofield.imagetoolkit",
    "productName": "洋芋田图像工具箱",
    "artifactName": "potatofield-image-toolkit-${version}.${ext}",
    "directories": {
      "output": "build",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://files.potatofield.cn/ImageToolkit/Packages/"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "potatofield-image-toolkit-setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "potatofield-image-toolkit-${version}.${ext}"
    }
  }
}
